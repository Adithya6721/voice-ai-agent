# ──────────────────────────────────────────────────────
# local-voice-ai environment configuration
# Copy this file to .env and fill in your values.
# No API keys required — all models run locally.
# ──────────────────────────────────────────────────────

# Logging
LOG_LEVEL=INFO
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Audio settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=30

# VAD settings
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=400

# ASR settings
ASR_MODEL=small          # tiny | base | small | medium | large-v3-turbo
ASR_LANGUAGE=en          # en | auto | fr | de | etc.
ASR_BEAM_SIZE=5
ASR_COMPUTE_TYPE=auto    # auto | int8 | float16 | float32

# Inference device
DEVICE=auto              # auto | cuda | cpu
CUDA_DEVICE_INDEX=0

# Paths
MODELS_DIR=./models
DATA_DIR=./data
LOGS_DIR=./logs
